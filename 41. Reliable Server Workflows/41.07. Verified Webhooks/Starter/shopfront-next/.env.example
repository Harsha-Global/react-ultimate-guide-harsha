# Copy to .env. Use your local PostgreSQL login; URL-encode special characters.
DATABASE_URL="postgresql://shopfront:REPLACE_ME@127.0.0.1:5432/shopfront_dev"
DIRECT_URL="postgresql://shopfront:REPLACE_ME@127.0.0.1:5432/shopfront_dev"
TEST_DATABASE_URL="postgresql://shopfront:REPLACE_ME@127.0.0.1:5432/shopfront_test"
COURSE_ALLOW_WRITES="disabled"

# Generate a private random secret; never use this placeholder.
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000

# Optional GitHub OAuth app. Callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local mailbox only accepts example.test recipients.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ShopFront <demo@example.test>

# Stripe sandbox only. Never add a live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
