{
  "name": "shopfront-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "api": "node scripts/sample-api.mjs",
    "api:reset": "node scripts/api-mode.mjs reset",
    "api:ready": "node scripts/api-mode.mjs ready",
    "api:slow": "node scripts/api-mode.mjs slow",
    "api:error": "node scripts/api-mode.mjs error",
    "host:build": "node scripts/host.mjs build",
    "host:start": "node scripts/host.mjs start",
    "db:check": "node scripts/db-check.mjs",
    "sql:lesson": "node scripts/sql-lesson.mjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "check": "tsc --noEmit",
    "auth:generate": "auth generate --config auth.schema.ts --adapter prisma --dialect postgresql --yes",
    "mail": "node scripts/mail-sink.mjs",
    "db:fixtures": "tsx prisma/fixtures.ts",
    "test:auth": "node scripts/test-server.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:input": "node scripts/test-server.mjs tests/input.integration.mjs",
    "test:database": "node scripts/test-database.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "dotenv": "17.2.3",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.7",
    "mailparser": "3.9.38",
    "prisma": "7.10.0",
    "smtp-server": "3.19.21",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  },
