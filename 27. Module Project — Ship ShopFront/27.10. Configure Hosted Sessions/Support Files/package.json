{
  "name": "shopfront-checkout",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src shared server",
    "preview": "vite preview",
    "check": "tsc -b",
    "api": "node server/index.mjs",
    "api:reset": "node server/reset.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "check:tests": "tsc -p tsconfig.test.json",
    "test:e2e": "playwright test",
    "start": "node server/production.mjs",
    "test:production": "playwright test --config playwright.production.config.ts",
    "verify:production": "node checks/verify-production.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.83.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
