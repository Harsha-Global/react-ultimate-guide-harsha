{
  "name": "shopfront-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "api": "node scripts/sample-api.mjs",
    "api:reset": "node scripts/api-mode.mjs reset",
    "api:ready": "node scripts/api-mode.mjs ready",
    "api:slow": "node scripts/api-mode.mjs slow",
    "api:error": "node scripts/api-mode.mjs error",
    "host:build": "node scripts/host.mjs build",
    "host:start": "node scripts/host.mjs start",
    "db:check": "node scripts/db-check.mjs",
    "sql:lesson": "node scripts/sql-lesson.mjs",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "check": "tsc --noEmit",
    "auth:generate": "auth generate --config auth.schema.ts --adapter prisma --dialect postgresql --yes",
    "mail": "node scripts/mail-sink.mjs",
    "db:fixtures": "tsx prisma/fixtures.ts",
    "test:auth": "node scripts/test-server.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:input": "node scripts/test-server.mjs tests/input.integration.mjs",
    "test:database": "node scripts/test-workflows.mjs tests/constraints.integration.ts",
    "test:stock": "node scripts/test-server.mjs tests/stock-race.integration.mjs",
    "test:orders": "node scripts/test-server.mjs tests/orders.integration.mjs",
    "test:signatures": "node --import tsx --test tests/payment.signature.test.mjs",
    "test:inbox": "node scripts/test-database.mjs tests/payment-inbox.integration.ts",
    "test:payments": "node scripts/test-database.mjs tests/payment-state.integration.ts",
    "storage": "node scripts/storage.mjs",
    "test:tickets": "node scripts/test-server.mjs tests/upload-ticket.integration.mjs",
    "test:uploads": "node scripts/test-server.mjs tests/uploads.integration.mjs",
    "jobs": "node scripts/jobs.mjs",
    "demo:receipt": "node --conditions=react-server --import tsx scripts/demo-job-order.ts receipt",
    "test:receipts": "node scripts/test-database.mjs tests/receipt.integration.ts",
    "outbox:dispatch": "node --conditions=react-server --import tsx scripts/outbox.mjs",
    "demo:outbox": "node --conditions=react-server --import tsx scripts/demo-job-order.ts outbox",
    "payments:recover": "node --conditions=react-server --import tsx scripts/recover-payments.mjs",
    "test:workflows": "node scripts/test-workflows.mjs",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:security": "node scripts/test-server.mjs tests/security.integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "11.7.0",
    "better-auth": "1.7.7",
    "dotenv": "17.2.3",
    "inngest": "4.23.0",
    "next": "16.4.0",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "web-vitals": "6.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "auth": "1.7.7",
    "inngest-cli": "1.46.0",
    "jsdom": "30.1.2",
    "mailparser": "3.9.38",
    "prisma": "7.10.0",
    "smtp-server": "3.19.21",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6",
    "adm-zip": "0.6.1"
  },
  "allowScripts": {
    "inngest-cli@1.46.0": true
  }
}
