# Copy to .env. Use your local PostgreSQL login; URL-encode special characters.
DATABASE_URL="postgresql://shopfront:REPLACE_ME@127.0.0.1:5432/shopfront_dev"
DIRECT_URL="postgresql://shopfront:REPLACE_ME@127.0.0.1:5432/shopfront_dev"
TEST_DATABASE_URL="postgresql://shopfront:REPLACE_ME@127.0.0.1:5432/shopfront_test"
COURSE_ALLOW_WRITES="disabled"

# Generate a private random secret; never use this placeholder.
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:3000

# Optional GitHub OAuth app. Callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local mailbox only accepts example.test recipients.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ShopFront <demo@example.test>

# Stripe sandbox only. Never add a live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SeaweedFS local-only setup. Disposable credentials, never reuse for hosting.
WEED_BINARY=C:/react/tools/seaweedfs/weed.exe
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=shopfront-uploads
S3_ACCESS_KEY=course-local-access
S3_SECRET_KEY=course-local-secret-for-disposable-files

# Local Inngest only. Hosting requires this to be disabled and cloud keys configured.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Separate course Sentry project. DSNs identify the destination; never add auth tokens to public variables.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
COURSE_TELEMETRY_DEMO=disabled

# Local production-build rehearsal. Hosted previews require separate backing services.
DEPLOYMENT_KIND=local
SITE_URL=http://localhost:3000
PORT=3000

# Create an empty, separate local database for the restore rehearsal.
RESTORE_DATABASE_URL="postgresql://shopfront:REPLACE_ME@127.0.0.1:5432/shopfront_restore"
# Optional directory containing the matching PostgreSQL client tools.
PG_BIN=C:/Program Files/PostgreSQL/18/bin
